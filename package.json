{
  "name": "scrollvars",
  "version": "1.13.0",
  "description": "Tiny scroll-driven animation engine: one rAF loop in, CSS variables out. Zero dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "scrollvars": "bin/scrollvars.mjs"
  },
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react/index.js",
    "./canvas": "./dist/canvas/index.js",
    "./compat": "./dist/compat/index.js",
    "./debug": "./dist/debug/index.js",
    "./styles.css": "./styles.css",
    "./styles/*.css": "./styles/*.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "dist/react/index.d.ts"
      ],
      "canvas": [
        "dist/canvas/index.d.ts"
      ],
      "debug": [
        "dist/debug/index.d.ts"
      ],
      "compat": [
        "dist/compat/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "bin",
    "styles",
    "CHANGELOG.md",
    "styles.css",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-styles.mjs",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "dev": "tsc -w",
    "test": "node --test test/",
    "test:e2e": "cd demo/bench/harness && npm i --silent && node e2e-invariants.mjs",
    "prepublishOnly": "npm run build && npm test",
    "demo:sync": "npm run build && node scripts/demo-sync.mjs && node scripts/fx-build.mjs && node scripts/docs-build.mjs",
    "demo:deploy": "npm run demo:sync && node scripts/demo-deploy.mjs"
  },
  "keywords": [
    "scroll",
    "animation",
    "css-variables",
    "scroll-driven",
    "parallax",
    "carousel",
    "slider",
    "scroll-snap",
    "intersection",
    "react",
    "nextjs",
    "rsc",
    "lightweight",
    "zero-dependencies"
  ],
  "author": "aduptive <aduptive@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aduptive/scrollvars.git"
  },
  "homepage": "https://scrollvars.dev",
  "bugs": "https://github.com/aduptive/scrollvars/issues",
  "private": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}

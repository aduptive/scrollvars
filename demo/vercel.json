{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "scrollvars.vercel.app" }],
      "destination": "https://scrollvars.dev/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.scrollvars.dev" }],
      "destination": "https://scrollvars.dev/:path*",
      "permanent": true
    }
  ]
}

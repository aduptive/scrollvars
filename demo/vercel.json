{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "scrollvars.vercel.app"
        }
      ],
      "destination": "https://scrollvars.dev/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.scrollvars.dev"
        }
      ],
      "destination": "https://scrollvars.dev/$1",
      "permanent": true
    }
  ]
}